// ==============================================================================
// TIA Portal SCL Source File
// Proje    : Polteks AI - Yuzey Kusur Denetimi (Surface Inspection)
// Versiyon : 0.3 - Hata Kilidi (Latch) ve Restart Ayrımı
// PLC      : Siemens S7-1200 / S7-1500
// ==============================================================================
// MANTIK:
//   - Python (Snap7), kamera görüntüsünde hata tespit ettiğinde DB1'e
//     AI_Result_Code = 2 (NOK) ve Defect_Type = 1 yazar.
//   - FB_Machine_Control, AI_Result_Code = 2 gördüğü anda Fault_Active = TRUE yapar
//     ve Motor_Cikis (%Q0.0) anında kesilir, Kırmızı Işık (%Q0.1) yanar.
//   - Kamera önünden hatalı parça geçip gitse dahi motor kendiliğinden çalışmaz!
//   - Sadece operatör fiziksel Restart butonuna bastığında (%I0.0) veya Python
//     üzerinden [R] tuşuna basılarak Restart_Cmd = 1 gönderildiğinde kilit açılır.
// ==============================================================================

// -----------------------------------------------------------------------------
// DATA BLOCK: DB_AI_Communication (DB1)
// NOT: TIA Portal'da bloğa sağ tıklayıp Properties -> Attributes sekmesinde
// "Optimized block access" İŞARETİ KALDIRILMALIDIR (S7_Optimized_Access := 'FALSE')
// -----------------------------------------------------------------------------
DATA_BLOCK "DB_AI_Communication"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.3
   VAR
      // Offset 0.0 (Int): AI Sonucu (0=Boşta, 1=OK / Sağlam, 2=NOK / Hata)
      AI_Result_Code : Int;
      // Offset 2.0 (Int): Hata Tipi Kodu (0=Yok, 1=Yüzey Kusuru)
      Defect_Type    : Int;
      // Offset 4.0 (Int): Python Restart Komutu (0=Yok, 1=Restart İste)
      Restart_Cmd    : Int;
   END_VAR
   BEGIN
      AI_Result_Code := 0;
      Defect_Type    := 0;
      Restart_Cmd    := 0;
END_DATA_BLOCK

// -----------------------------------------------------------------------------
// FUNCTION BLOCK: FB_Machine_Control (FB1)
// -----------------------------------------------------------------------------
FUNCTION_BLOCK "FB_Machine_Control"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.3

   VAR_INPUT
      System_Enable_Switch : Bool;  // Ana Çalıştırma Şalteri / Anahtarı (1=Sistem Aktif)
      Restart_Button       : Bool;  // Arıza Sonrası Başlatma Butonu (Yükselen Kenar)
   END_VAR

   VAR_OUTPUT
      Motor_Cikis          : Bool;  // Motor Kontaktörü / Sürücü Enable (%Q0.0)
      Red_Light            : Bool;  // Kırmızı Arıza Lambası (%Q0.1)
      Green_Light          : Bool;  // Yeşil Normal Çalışıyor Lambası (%Q0.2)
   END_VAR

   VAR
      Fault_Active         : Bool;  // Arıza Kilit Hafızası (Latching Flag)
      Restart_Btn_Prev     : Bool;  // Buton Yükselen Kenar Takip Değişkeni
   END_VAR

   BEGIN

   // =========================================================================
   // 1. HATA YAKALAMA: AI'den NOK (2) gelirse sistemi anında kilitle
   // =========================================================================
   IF "DB_AI_Communication".AI_Result_Code = 2 THEN
       #Fault_Active := TRUE;
   END_IF;

   // =========================================================================
   // 2. RESTART: Fiziksel Buton Yükselen Kenarı VEYA Python Restart_Cmd = 1
   // =========================================================================
   IF (#Restart_Button AND NOT #Restart_Btn_Prev) OR
      ("DB_AI_Communication".Restart_Cmd = 1) THEN

       // Hatayı temizle, motora tekrar izin ver
       #Fault_Active := FALSE;

       // AI veri bloğundaki sinyalleri temizle
       "DB_AI_Communication".AI_Result_Code := 0;
       "DB_AI_Communication".Defect_Type    := 0;
       "DB_AI_Communication".Restart_Cmd    := 0;

   END_IF;

   #Restart_Btn_Prev := #Restart_Button;

   // =========================================================================
   // 3. MOTOR VE ÇIKIŞ YÖNETİMİ
   //    - Sistem Şalteri ON ve HATA YOKSA -> Motor Çalışır
   //    - Aksi halde -> Motor Durur
   // =========================================================================
   IF #System_Enable_Switch AND NOT #Fault_Active THEN
       #Motor_Cikis := TRUE;
       #Green_Light := TRUE;
       #Red_Light   := FALSE;
   ELSE
       #Motor_Cikis := FALSE;
       #Green_Light := FALSE;

       IF #Fault_Active THEN
           #Red_Light := TRUE;   // Arıza kaynaklı duruş -> Kırmızı Lamba Yansın
       ELSE
           #Red_Light := FALSE;  // Sadece şalter kapalı -> Lamba Sönük
       END_IF;
   END_IF;

END_FUNCTION_BLOCK

